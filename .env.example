# Clerk is the identity layer. Configure Google sign-in in Clerk and restrict
# employee access to verified @leatherbacktravel.com identities.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER_URL=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-in
# Canonical primary URL used by satellite applications and the access service.
COVE_PRIMARY_URL=https://lbcove.vercel.app

# Local demo identity. Vercel previews enable demo mode automatically, while
# production always requires Clerk and live services.
COVE_PREVIEW_MODE=true

# SuperPanel control-plane persistence (provisioned in the database slice).
DATABASE_URL=
# One-time, allowlisted first administrator. Remove after the first successful
# authenticated bootstrap has created the database record.
COVE_BOOTSTRAP_ADMIN_EMAIL=
# Airtable is accessed server-side only. Never prefix these with NEXT_PUBLIC_.
AIRTABLE_DIRECTORY_TOKEN=
AIRTABLE_DIRECTORY_BASE_ID=appYP9nVmzqan2PlU
AIRTABLE_DIRECTORY_TABLE=tblJ6mB7XXWnMbezL
# Recruitment uses Airtable unless the lake source and database URL are both set.
RECRUITMENT_SOURCE=airtable
# Do not add an sslmode query parameter; TLS is configured by the application.
RECRUITMENT_LAKE_DATABASE_URL=
# Shared Team Operations / HR connection used by People and injury reporting.
AIRTABLE_HR_TOKEN=
AIRTABLE_HR_BASE_ID=appYP9nVmzqan2PlU
AIRTABLE_INJURIES_TABLE=tblOXrKn3Pl6jV2Fz
AIRTABLE_INJURIES_EMPLOYEE_FIELD=Team Members
AIRTABLE_INJURIES_WRITES_ENABLED=false
AIRTABLE_BRANDS_TOKEN=
AIRTABLE_BRANDS_BASE_ID=appFKK9f5PuUq27Cl
AIRTABLE_BRANDS_TABLE=tblIQseMMVbh3hIsk

# Systems-only SuperPanel inventory. Use a dedicated read-only credential;
# never reuse a developer token or an organisation-owner credential.
COVE_GITHUB_ORG=leatherback-travel-organisation
COVE_GITHUB_READ_TOKEN=

# Least-privilege GitHub App used to prepare reviewed Cove authentication PRs.
# It needs repository Contents and Pull requests write access only.
COVE_GITHUB_APP_ID=
COVE_GITHUB_APP_INSTALLATION_ID=
COVE_GITHUB_APP_PRIVATE_KEY=

# Scoped Vercel token used to identify a registered Sub-App project and queue
# its encrypted production environment. Environment changes do not redeploy an
# existing build; the approved GitHub merge remains the deployment checkpoint.
COVE_VERCEL_API_TOKEN=

# Your Money uses the existing Leatherback HR & Team Operations base. Employee
# reads are matched server-side to the immutable linked Team Member record ID
# (or verified email where the table stores one). Keep writes disabled until
# field names and linked-record types have been verified.
AIRTABLE_MONEY_TOKEN=
AIRTABLE_MONEY_BASE_ID=
AIRTABLE_INVOICES_TABLE=Invoices - Euro Team
AIRTABLE_TRAVEL_CREDITS_TABLE=Travel Credits
AIRTABLE_REIMBURSEMENTS_TABLE=Reimbursements
AIRTABLE_MONEY_EMPLOYEE_FIELD=Name
AIRTABLE_MONEY_EMAIL_FIELD=Employee Email
AIRTABLE_MONEY_NAME_FIELD=Employee Name
AIRTABLE_MONEY_TITLE_FIELD=Title
AIRTABLE_MONEY_AMOUNT_FIELD=Amount
AIRTABLE_MONEY_CURRENCY_FIELD=Currency
AIRTABLE_MONEY_STATUS_FIELD=Status
AIRTABLE_MONEY_SUBMITTED_FIELD=Submitted At
AIRTABLE_MONEY_DESCRIPTION_FIELD=Description
AIRTABLE_MONEY_ADMIN_NOTE_FIELD=Admin Notes
AIRTABLE_MONEY_COUNTERPARTY_FIELD=
AIRTABLE_MONEY_CATEGORY_FIELD=
AIRTABLE_MONEY_TRANSACTION_DATE_FIELD=
AIRTABLE_MONEY_WRITES_ENABLED=false
# Shared bootstrap credential for the two scoped Claude-to-Codex delegate handoffs.
# Store the real value only in Vercel and untracked local environment files.
COVE_DELEGATE_BOOTSTRAP_TOKEN=

# --- Leatherback Booking (booking sub-app) -------------------------------
# Airtable is READ-ONLY here, always. Bookings base + HR base (leave, for the
# coverage map only — never an input to slot computation).
AIRTABLE_BOOKING_TOKEN=
AIRTABLE_BOOKING_BASE_ID=appnRSV0g89whVidp
AIRTABLE_HR_BASE_ID=appYP9nVmzqan2PlU
# Notion staff directory (Team Directory (new) data source).
NOTION_TOKEN=
NOTION_TEAM_DIRECTORY_DS=3563b112-a0e0-80a7-a6fb-000b4827bc09
# Google Calendar via domain-wide delegation. Base64 of the service-account
# JSON key. Scopes: calendar.readonly + calendar.events, nothing broader.
GOOGLE_SA_KEY_B64=
# Email sending. Unset = NoopNotifier (renders + logs, sends nothing).
RESEND_API_KEY=
# Help Scout Mailbox API 2.0 app credentials. Unset = stub.
HELPSCOUT_APP_ID=
HELPSCOUT_APP_SECRET=
# Aircall (per-brand support numbers). Unset = numbers stay as seeded.
AIRCALL_API_ID=
AIRCALL_API_TOKEN=
# Slack incoming webhook for booking alerts. Unset = alerts logged only.
BOOKING_SLACK_WEBHOOK_URL=
# Cloudflare Turnstile for public booking forms. Unset = check skipped in dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Secret for derived manage tokens in reminder emails (falls back to
# COVE_HANDOFF_SECRET when unset).
BOOKING_TOKEN_SECRET=
